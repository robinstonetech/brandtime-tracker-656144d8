{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandtime-tracker",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client"
  },
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ]
}